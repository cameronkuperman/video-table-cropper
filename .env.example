# Copy this file to .env and fill in your values.

# Google Drive service account credentials (choose one):
DRIVE_SERVICE_ACCOUNT_JSON_PATH=/absolute/path/to/service-account.json
# DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# DRIVE_SERVICE_ACCOUNT_JSON_B64=<base64-encoded JSON>

# The single Google Drive folder that contains all 6 subfolders.
# The app will auto-create raw_videos/, temp_processing/, unlabeled/,
# clean/, dirty/, occupied/, and label_later/ inside this folder if they
# don't exist yet.
DRIVE_PROJECT_ROOT_FOLDER_ID=your_folder_id_here

# Required for online deployment when AUTH_REQUIRED=1.
AUTH_REQUIRED=1
LABELER_PASSWORD=change-me
FLASK_SECRET_KEY=generate-a-long-random-string

# Optional label preview cache settings. By default previews are cached outside
# the repo under LocalAppData (Windows) or the system temp directory.
# LABEL_CACHE_DIR=
# LABEL_CACHE_TTL_HOURS=72
# LABEL_CACHE_MAX_MB=1024

# Optional queue/prewarm tuning for low-latency labeling.
# LABEL_UNLABELED_CACHE_SECONDS=300
# LABEL_QUEUE_BATCH_DEFAULT=72
# LABEL_QUEUE_BATCH_MAX=300
# LABEL_QUEUE_HYDRATE_WORKERS=12
# LABEL_PREVIEW_PREWARM_WORKERS=24
# LABEL_FOLDER_PREWARM_WORKERS=12
# LABEL_PREWARM_FOLDER_COUNT=180
# LABEL_READY_SCAN_MULTIPLIER=12
# LABEL_READY_SCAN_MAX=720
# LABEL_QUEUE_RETRY_MS=250

# Optional online auto-preprocessing tuning.
# AUTOLABEL_VIDEO_LOW_WATERMARK=50
# AUTOLABEL_VIDEO_BATCH_SIZE=3
# LABEL_REOLINK_PREWARM_TARGET=200
# REOLINK_TRUE_TEN_BATCH_SIZE=4
# REOLINK_YOLO_BATCH_FRAMES=40
# REOLINK_PREPROCESS_MAX_SECONDS=0
# PREPROCESS_SOURCES=reolink
# YOLO_MODEL_NAME=yolo26l-seg.pt

# Optional Supabase crop lookup for ScreenRecord/Reolink sites.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SECRET_KEY=your-service-role-or-secret-key
# DATABASE_URL=postgresql://postgres:...@db.your-project-ref.supabase.co:5432/postgres
# DB_URL=postgresql://postgres:...@db.your-project-ref.supabase.co:5432/postgres
# DATABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# DB_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# SUPABASE_DB_SCHEMA=public
# SUPABASE_CROP_CACHE_TTL_SECONDS=300

# Optional timing logs for latency tuning.
# LABEL_TIMING_LOGS=1
# LABEL_TIMING_LOG_MIN_MS=0
